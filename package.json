{
  "name": "nadr-cms-pro",
  "version": "1.1.102",
  "description": "NADR Master Case Management System Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "cms",
    "electron"
  ],
  "author": "Lay Oun",
  "license": "ISC",
  "build": {
    "appId": "com.nadr.cmspro",
    "productName": "NADR CMS Pro",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "manifest.json",
      "favicon.ico",
      "css/*.css",
      "images/**/*",
      "vendor/**/*",
      "templates/**/*",
      "lib/*.js",
      "js/*.js",
      "!js/*.bak*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "images/icon.ico",
      "artifactName": "NADR-CMS-Pro-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "NADR CMS Pro",
      "installerIcon": "favicon.ico",
      "uninstallerIcon": "favicon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ounlay503040-sys",
        "repo": "Case-Management-"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  }
}